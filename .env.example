# Environment Variables Example — FIT SUPPLEMENT
# คัดลอกไฟล์นี้เป็น .env.local สำหรับเครื่องพัฒนา หรือตั้งค่าบน Vercel สำหรับ Production
# ห้าม commit ไฟล์ .env.local ขึ้น GitHub เด็ดขาด

# Option 1 (Production — Vercel Marketplace Neon Cloud PostgreSQL)
# หากกำหนด DATABASE_URL ระบบจะเชื่อมต่อ PostgreSQL อัตโนมัติ
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Option 2 (Local Development — XAMPP MySQL หรือ TiDB Cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=fitsupp
DB_SSL=false

# สร้างค่าสุ่มด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
